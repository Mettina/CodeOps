# Every variable the app reads. Copy to .env.local for local work; on Vercel add each one in
# Project > Settings > Environment Variables and choose Development / Preview / Production
# separately. Never commit .env.local.

# Signs the session cookie. SECRET. Use a DIFFERENT value for Preview and Production.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated email addresses allowed to open the staff dashboard.
# Sign-in currently has no password or email verification; this is demo access control only.
STAFF_EMAILS=

# Public site URL for metadataBase, sitemap and robots (not a secret).
#   Local:      http://localhost:3000
#   Preview:    leave UNSET on Vercel (the preview's own URL is used automatically)
#   Production: leave unset to use the Vercel domain, or set your real domain
SITE_URL=http://localhost:3000
